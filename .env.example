# SpaceXAI / xAI key — used only when the narrative provider is Grok 4.6.
# Get a key at https://console.x.ai
XAI_API_KEY=

# LM Studio (default narrative provider). Start the local server, then load a model.
# GET http://localhost:1234/v1/models should list the loaded checkpoint.
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=qwen/qwen3.8-27b
# OpenAI Python SDK requires a key string; LM Studio ignores it.
LM_STUDIO_API_KEY=lm-studio

# Optional Hugging Face cache so model weights stay out of $HOME.
# HF_HOME=./hf_cache

# Optional: pin an AMD GPU when several are present (ROCm uses HIP_VISIBLE_DEVICES).
# HIP_VISIBLE_DEVICES=0
# CUDA_VISIBLE_DEVICES=0
